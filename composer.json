{
    "name": "zarnite/sdk",
    "description": "Official PHP SDK for the Zarnite AI platform",
    "keywords": [
        "zarnite",
        "sdk",
        "ai",
        "tutor",
        "voice",
        "rag"
    ],
    "homepage": "https://github.com/ZZARN/zarnite-sdk-php",
    "license": "MIT",
    "authors": [
        {
            "name": "zarnite",
            "email": "support@zarnite.com",
            "homepage": "https://zarnite.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "Zarnite\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Zarnite\\Test\\" : "test/" }
    }
}
